@media (prefers-color-scheme: dark) {
    page {
        background-color: rgb(29, 29, 29);
    }

    .body {
        background-color: rgb(29, 29, 29);
    }

    .card {
        background: rgb(17, 17, 17);
        box-shadow: none;
    }

    .hero-title,
    .section-title,
    .metric-value,
    .device-name {
        color: rgb(238, 238, 238);
    }

    .hero-subtitle,
    .metric-label,
    .device-desc {
        color: rgb(153, 153, 153);
    }

    .status-pill {
        background: rgb(34, 34, 34);
        color: rgb(170, 170, 170);
    }

    .metric {
        background: rgb(26, 26, 26);
    }

    .light-card {
        background: rgb(26, 35, 64);
    }

    .sign-card {
        background: rgb(61, 28, 31);
    }

    .dian1 {
        background: rgb(64, 64, 64);
    }

    .dian2 {
        background: rgb(118, 164, 236);
    }

    .dian3 {
        background: rgb(2, 96, 0);
    }

    .dian4 {
        background: rgb(105, 58, 0);
    }

    .dian5 {
        background: rgb(224, 54, 8);
    }

    .dian {
        background: rgb(64, 64, 64);
    }
}
