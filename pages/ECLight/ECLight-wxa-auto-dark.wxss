@media (prefers-color-scheme: dark) {
    .body {
        background-color: rgb(29, 29, 29);
    }

    .line {
        background: rgb(83, 83, 83);
    }

    .h2 {
        color: rgb(186, 178, 178);
    }

    .tab_item {
        background: rgb(17, 17, 17);
    }

    .mainbj {
        background-color: rgb(17, 17, 17);
    }

    .CPimage1 {
        background-color: rgb(0, 64, 16);
    }

    .changone {
        background-color: rgb(29, 29, 29);
    }

    .changtow {
        background-color: rgb(29, 29, 29);
    }

    .container {
        background-color: rgb(17, 17, 17);
    }

    .slider-light .wx-slider-track {
        background: rgb(0, 0, 0);
    }

    @keyframes puff-out-horizontal {
        0% {
            transform: scaleX(1);
            filter: blur(0);
            opacity: 1;
        }

        100% {
            transform: scaleX(2);
            filter: blur(4px);
            opacity: 0;
        }
    }
}
