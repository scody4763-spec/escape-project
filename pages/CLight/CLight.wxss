/* pages/Capital/Capital.wxss */
.body {
  padding: 10px 3%;
  height: 100%;
  background-color: #eee;
}

.line {
  width: 100%;
  /* （线的宽度） */
  height: 2rpx;
  /* （线的高度，就是线粗度） */
  background: #aaa;
  /* （线的颜色） */
  margin: 10px 0px;
}

/* 灰 */
.dian1 {
  margin: 6px 15px 5px 20px;
  float: left;
  width: 10px;
  height: 10px;
  background: #c1c1c1;
  -moz-border-radius: 50px;
  -webkit-border-radius: 50px;
  border-radius: 50px;

}

