/* pages/about/about.wxss */
page {
  background-color: #f5f5f5;
  height: 100%;
}

/* ===== 头部区域 ===== */
.header {
  background: linear-gradient(135deg, #31869B 0%, #1a5c6e 100%);
  padding: 60rpx 0 50rpx 0;
  text-align: center;
  position: relative;
}

.header-logo {
  width: 120rpx;
  height: 120rpx;
  border-radius: 24rpx;
  background: rgba(255,255,255,0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 20rpx auto;
}

.header-logo image {
  width: 80rpx;
  height: 80rpx;
}

.header-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 10rpx;
}

.header-version {
  font-size: 24rpx;
  color: rgba(255,255,255,0.8);
  background: rgba(255,255,255,0.15);
  display: inline-block;
  padding: 4rpx 20rpx;
  border-radius: 20rpx;
}

.header-desc {
  font-size: 26rpx;
  color: rgba(255,255,255,0.7);
  margin-top: 16rpx;
}

/* ===== 内容卡片 ===== */
.card {
  background: #ffffff;
  border-radius: 20rpx;
  margin: 30rpx 30rpx 0 30rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.05);
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 24rpx;
  padding-left: 16rpx;
  border-left: 6rpx solid #31869B;
}

.card-text {
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
  text-indent: 2em;
}

/* ===== 功能列表 ===== */
.feature-list {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.feature-item {
  width: 48%;
  background: #f8fafb;
  border-radius: 16rpx;
  padding: 24rpx 20rpx;
  margin-bottom: 20rpx;
  box-sizing: border-box;
  text-align: center;
}

.feature-icon {
  width: 60rpx;
  height: 60rpx;
  margin-bottom: 12rpx;
}

.feature-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.feature-desc {
  font-size: 22rpx;
  color: #999;
  line-height: 1.5;
}

/* ===== 技术参数 ===== */
.tech-list {
  display: flex;
  flex-direction: column;
}

.tech-item {
  display: flex;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.tech-item:last-child {
  border-bottom: none;
}

.tech-label {
  width: 160rpx;
  font-size: 28rpx;
  color: #999;
  flex-shrink: 0;
}

.tech-value {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

/* ===== 底部信息 ===== */
.footer {
  text-align: center;
  padding: 40rpx 30rpx 60rpx 30rpx;
}

.footer-text {
  font-size: 24rpx;
  color: #ccc;
  line-height: 1.8;
}

.footer-highlight {
  color: #31869B;
}