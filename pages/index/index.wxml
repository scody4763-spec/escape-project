<!--index.wxml-->
<view class="body">
  <!-- 主设备卡片 -->
  <view class="card hero-card" bindtap="gotoPage">
    <view class="hero-header">
      <text class="hero-title">{{Group.GroupName}}</text>
      <text class="hero-subtitle">环境实时监测中……</text>
    </view>

    <image class="hero-image" src="../ECLight/img/双向.png" mode="aspectFit" bindtap="gotoPage"/>

    <view class="status-bar">
      <view class="status-pill">
        <image class="status-icon" src="./img/信号.png" mode="aspectFit"/>
        <text>Cat.1网络已连接…</text>
      </view>
      <view class="status-pill">
        <image class="status-icon" src="./img/mesh.png" mode="aspectFit"/>
        <text>Mesh网关运行中…</text>
      </view>
    </view>
  </view>

  <!-- 实时环境数据 -->
  <view class="card data-card">
    <view class="section-title">实时环境数据</view>
    <view class="metric-grid">
      <view class="metric">
        <view class="metric-dot {{now.TEMPERcolor || 'dian4'}}"></view>
        <view class="metric-info">
          <text class="metric-label">温度：</text>
          <text class="metric-value">{{now.TEMPER || '--'}}°C</text>
        </view>
      </view>
      <view class="metric">
        <view class="metric-dot {{now.HUDcolor || 'dian2'}}"></view>
        <view class="metric-info">
          <text class="metric-label">湿度：</text>
          <text class="metric-value">{{now.HUD || '--'}}</text>
        </view>
      </view>
      <view class="metric">
        <view class="metric-dot {{now.TVOCcolor || 'dian3'}}"></view>
        <view class="metric-info">
          <text class="metric-label">TVOC：</text>
          <text class="metric-value">{{now.TVOC != null ? now.TVOC : '--'}}</text>
        </view>
      </view>
      <view class="metric">
        <view class="metric-dot {{now.STATUS === '报警中' ? 'dian5' : 'dian3'}}"></view>
        <view class="metric-info">
          <text class="metric-label">状态：</text>
          <text class="metric-value {{now.STATUS === '报警中' ? 'status-alarm' : ''}}">{{now.STATUS || '正常'}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 设备 -->
  <view class="card">
    <view class="section-title">设备</view>
    <view class="device-row">
      <view class="device-card light-card {{now.STATUS === '报警中' ? 'warning' : ''}}">
        <view class="device-text">
          <text class="device-name">指示灯</text>
          <text class="device-desc">{{now.STATUS === '报警中' ? '报警中' : '正常运行'}}</text>
        </view>
        <image class="device-img" src="../ECLight/img/双向.png" mode="aspectFit"/>
      </view>
      <view class="device-card sign-card {{now.STATUS === '报警中' ? 'warning' : ''}}">
        <view class="device-text">
          <text class="device-name">吸顶灯</text>
          <text class="device-desc">{{now.STATUS === '报警中' ? '报警中' : '正常运行'}}</text>
        </view>
        <image class="device-img" src="./img/CLight.png" mode="aspectFit"/>
      </view>
    </view>
  </view>

  <!-- 逃生模式入口 -->
  <view class="escape-entry" bindtap="gotoEscape">
    <view class="escape-entry-content">
      <text class="escape-entry-icon">🔥</text>
      <text class="escape-entry-text">点击进入逃生模式</text>
    </view>
    <text class="escape-entry-arrow">›</text>
  </view>
</view>