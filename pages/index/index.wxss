.table {
  display: flex;
  flex-direction: column;
  /* 排列形式: 向下 */

}

.tr {
  display: flex;
  flex-direction: row;
  height: 33px;
}

.th,
.td {
  /* 公有的属性 */
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  /* 自动换行 */
  width: 30%;
  /* 4个25%相加刚好100% */
  text-align: center;
  /* text-align: left; */
  /* 文本居中 */
  justify-content: center;
  /* 主轴居中 */
  align-items: center;
  /* 交叉轴居中 */

}

.td1 {
  /* 公有的属性 */
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  /* 自动换行 */
  width: 20%;
  /* 4个25%相加刚好100% */
  text-align: center;
  /* text-align: left; */
  /* 文本居中 */
  justify-content: center;
  /* 主轴居中 */
  align-items: center;
  /* 交叉轴居中 */

}

.th {
  font-weight: 800;
  /* 字体加重 */
  /* background-color: #B3CCF4; */
  /* 背景色 */
}

.td {
  display: block;
  line-height: 100%;
  text-align:center;
  /* background-color: #edf3e9; */
  /* 背景色 */
}

.h2 {
  /* font-size: 14px; */
  padding-bottom: 10px;
  color: rgb(80, 73, 73);
  font-weight: 700;
}

.t1 {
  padding-top: 10px;
}


.tab_item {

  display: block;
  background: #fff;
  position: relative;
  padding: 7px 10px;
  border-radius: 15px;
  margin: 0 0 10px 0;
}

.item-icon {
  display: inline;
  height: 30px;
  width: 30px;
}

.item-img {
  margin:6px 10px 0px 10px;
  height: 99px;
  width: 135px;
}


.item-title {
  padding: 5px;
  font-weight: 500;
  display: flex;
  flex-direction: row;
  justify-content: left;
}

.tag {
  /* width: 0;
    height: 0; */
  text-align: center;
  position: absolute;
  float: right;
  position: relative;
  left: 10px;
  top: -8px;
 
  border-bottom: 40px solid transparent;
  border-right: 40px solid rgb(255, 103, 29);
}

.tag-txt {
  text-align: center;
  position: absolute;
  color: rgb(255, 223, 200);
  line-height: 18px;
  top:10px;
  right: 0;
  transform: rotate(45deg);
  line-height: 7px;
  font-size: 15px;
}

@import 'index-wxa-auto-dark.wxss'