<!-- 逃生模式页面 -->
<view class="BJmain">
  <!-- 非逃生模式：显示等待界面 -->
  <view class="mainbj" wx:if="{{!escapeMode}}">
    <view class="waiting-panel">
      <image class="waiting-icon" src="./img/双向.png" mode="aspectFit" />
      <text class="waiting-title">应急指示灯</text>
      <text class="waiting-desc">等待火警信号中…</text>
      <button class="escape-btn-test" bindtap="startEscape">开始逃生模式（测试）</button>
    </view>
  </view>

  <!-- 逃生模式面板 -->
  <view class="escape-panel" wx:if="{{escapeMode}}">
    <view class="escape-header">
      <text class="escape-title">🔥 火灾逃生模式</text>
      <view class="escape-badge">逃生中</view>
    </view>

    <view class="escape-direction">
      <view class="escape-arrow">{{directionArrow}}</view>
      <view class="escape-text">请向{{escapeDirection || '前方'}}逃生</view>
    </view>

    <view class="escape-info">
      <view class="escape-item">
        <text class="escape-label">当前位置：</text>
        <text class="escape-value">{{currentLocation}}</text>
      </view>
      <view class="escape-item">
        <text class="escape-label">最近出口：</text>
        <text class="escape-value">{{exitName}}</text>
      </view>
      <view class="escape-item">
        <text class="escape-label">距离：</text>
        <text class="escape-value">{{distance}} 米</text>
      </view>
      <view class="escape-item">
        <text class="escape-label">预计时间：</text>
        <text class="escape-value">{{estimatedTime}} 秒</text>
      </view>
    </view>

    <view class="escape-actions">
      <button class="escape-btn-stop" bindtap="stopEscape">停止逃生</button>
      <button class="escape-btn-danger" bindtap="call119">📞 拨打119</button>
      <button class="escape-btn-voice" bindtap="playVoiceGuide">🔊 语音指引</button>
    </view>
  </view>
</view>