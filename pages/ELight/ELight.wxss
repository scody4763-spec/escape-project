/* pages/Capital/Capital.wxss */
.body {
  padding: 10px 3%;
  height: 100vh;
  background-color: #eee;
}

.line {
  width: 100%;
  /* （线的宽度） */
  height: 4px;
  /* （线的高度，就是线粗度） */
  background: #eee;
  /* （线的颜色） */
  margin: 10px 0px;
}


