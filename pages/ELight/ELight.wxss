.td {
  /* 公有的属性 */
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  /* 自动换行 */
  width: 30%;
  /* 4个25%相加刚好100% */
  text-align: center;
  /* text-align: left; */
  /* 文本居中 */
  justify-content: center;
  /* 主轴居中 */
  align-items: center;
  /* 交叉轴居中 */

}

.td1 {
  /* 公有的属性 */
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  /* 自动换行 */
  width: 20%;
  /* 4个25%相加刚好100% */
  text-align: center;
  /* text-align: left; */
  /* 文本居中 */
  justify-content: center;
  /* 主轴居中 */
  align-items: center;
  /* 交叉轴居中 */

}

.th {
  font-weight: 800;
  /* 字体加重 */
  /* background-color: #B3CCF4; */
  /* 背景色 */
}

.td {
  display: block;
  line-height: 100%;
  text-align: center;
  /* background-color: #edf3e9; */
  /* 背景色 */
}

.h2 {
  /* font-size: 14px; */
  padding-bottom: 10px;
  color: rgb(80, 73, 73);
  font-weight: 700;
}

.t1 {
  padding-top: 10px;
}


.tab_item {

  display: block;
  background: #fff;
  position: relative;
  padding: 7px 10px;
  border-radius: 15px;
  margin: 0 0 10px 0;
}

.item-icon {
  display: inline;
  height: 30px;
  width: 30px;
}

.item-img {
  margin: 6px 10px 0px 10px;
  height: 99px;
  width: 135px;
}


.item-title {
  padding: 5px;
  font-weight: 500;
  display: flex;
  flex-direction: row;
  justify-content: left;
}

.tag {
  /* width: 0;
    height: 0; */
  text-align: center;
  position: absolute;
  float: right;
  position: relative;
  left: 10px;
  top: -5px;

  border-bottom: 40px solid transparent;
  border-right: 40px solid rgb(255, 103, 29);
}

.tag-txt {
  text-align: center;
  position: absolute;
  color: rgb(255, 223, 200);
  line-height: 18px;
  top: 11px;
  right: 0;
  transform: rotate(45deg);
  line-height: 7px;
  font-size: 15px;
}

.slider-light .wx-slider-track {
  background: linear-gradient(to right, #ffffff 0%, #40c76d 100%);
}

@keyframes puff-out-horizontal {
			
  0% {
    transform:scaleX(1);
    filter:blur(0);
    opacity:1;
  }
  100% {
    transform:scaleX(2);
    filter:blur(4px);
    opacity:0;
  }
}

@import 'ELight-wxa-auto-dark.wxss'

/* ===== 逃生模式样式 ===== */
.escape-panel {
  margin-top: 20rpx;
  padding: 30rpx;
  background: linear-gradient(135deg, #ff4444, #cc0000);
  border-radius: 16rpx;
  color: #ffffff;
}

.escape-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.escape-title {
  font-size: 36rpx;
  font-weight: bold;
}

.escape-badge {
  background: rgba(255,255,255,0.3);
  padding: 6rpx 20rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
}

.escape-direction {
  text-align: center;
  padding: 30rpx 0;
}

.escape-arrow {
  font-size: 120rpx;
  line-height: 1.2;
  animation: escape-bounce 1s infinite;
}

.escape-text {
  font-size: 32rpx;
  margin-top: 10rpx;
}

.escape-info {
  background: rgba(255,255,255,0.15);
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.escape-item {
  display: flex;
  justify-content: space-between;
  padding: 8rpx 0;
  font-size: 28rpx;
}

.escape-label {
  opacity: 0.85;
}

.escape-value {
  font-weight: bold;
}

.escape-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.escape-btn-danger {
  flex: 1;
  background: #ffffff;
  color: #cc0000;
  font-weight: bold;
  border-radius: 12rpx;
}

.escape-btn-voice {
  flex: 1;
  background: rgba(255,255,255,0.3);
  color: #ffffff;
  border-radius: 12rpx;
}

.escape-toggle {
  margin-top: 20rpx;
}

.escape-btn-test {
  background: #31869B;
  color: #ffffff;
  border-radius: 16rpx;
  font-size: 36rpx;
  font-weight: bold;
  height: 100rpx;
  line-height: 100rpx;
  padding: 0;
}

.escape-btn-stop {
  flex: 1 1 100%;
  background: rgba(0, 0, 0, 0.25);
  color: #ffffff;
  font-weight: bold;
  border-radius: 12rpx;
}

@keyframes escape-bounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-10rpx); }
}
