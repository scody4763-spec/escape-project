.table {
  display: flex;
  flex-direction: column;
  /* 排列形式: 向下 */

}

.tr {
  display: flex;
  flex-direction: row;
  height: 44px;
  align-items: center;
}

.dot {
  width: 8%;
  display: flex;
  justify-content: center;
  align-items: center;
}

.label {
  width: 22%;
  display: flex;
  justify-content: flex-end;
  align-items: center;
  font-size: 32rpx;
}

.value {
  width: 20%;
  display: flex;
  justify-content: flex-start;
  align-items: center;
  font-size: 32rpx;
}

.diag-btn {
  font-size: 36rpx;
  font-weight: bold;
  color: #d33a31;
}

.dot .dian2,
.dot .dian3 {
  width: 16rpx;
  height: 16rpx;
  margin: 0;
  box-shadow: 0 0 0 6rpx rgba(61, 110, 159, 0.15);
}

.dot .dian3 {
  box-shadow: 0 0 0 6rpx rgba(114, 190, 87, 0.15);
}

.data-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  margin-top: 24rpx;
}

.data-card {
  width: 30%;
  min-height: 130rpx;
  margin: 0 1.5% 18rpx;
  border-radius: 16rpx;
  padding: 20rpx 12rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
}

.data-label {
  font-size: 26rpx;
  color: #64748b;
  margin-bottom: 12rpx;
}

.data-value {
  font-size: 42rpx;
  font-weight: 700;
}

.card-temp .data-value { color: #ff6b6b; }
.card-hum .data-value { color: #3b82f6; }
.card-status .data-value { color: #22c55e; }
.card-aqi .data-value { color: #f59e0b; }
.card-tvoc .data-value { color: #8b5cf6; }
.card-co2 .data-value { color: #06b6d4; }
.card-fire .data-value { color: #ef4444; }
.card-hot .data-value { color: #f97316; }

.escape-toggle-top {
  margin-top: 24rpx;
}

.escape-toggle-top .escape-btn-test {
  width: 100%;
}

