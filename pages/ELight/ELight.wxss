page {
  background-color: #1a1a2e;
  height: 100%;
}

.BJmain {
  display: flex;
  justify-content: center;
  flex-direction: column;
  align-items: center;
  min-height: 100vh;
  padding: 30rpx;
  box-sizing: border-box;
}

.mainbj {
  width: 100%;
}

/* ===== 等待界面 ===== */
.waiting-panel {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 40rpx;
  background: rgba(255,255,255,0.05);
  border-radius: 24rpx;
  backdrop-filter: blur(10px);
}

.waiting-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 30rpx;
  opacity: 0.8;
}

.waiting-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 16rpx;
}

.waiting-desc {
  font-size: 28rpx;
  color: rgba(255,255,255,0.6);
  margin-bottom: 60rpx;
}

/* ===== 逃生模式样式 ===== */
.escape-panel {
  width: 100%;
  padding: 30rpx;
  background: linear-gradient(135deg, #ff4444, #cc0000);
  border-radius: 24rpx;
  color: #ffffff;
  box-shadow: 0 20rpx 60rpx rgba(204, 0, 0, 0.4);
}

.escape-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.escape-title {
  font-size: 36rpx;
  font-weight: bold;
}

.escape-badge {
  background: rgba(255,255,255,0.3);
  padding: 6rpx 20rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
}

.escape-direction {
  text-align: center;
  padding: 30rpx 0;
}

.escape-arrow {
  font-size: 120rpx;
  line-height: 1.2;
  animation: escape-bounce 1s infinite;
}

.escape-text {
  font-size: 32rpx;
  margin-top: 10rpx;
}

.escape-info {
  background: rgba(255,255,255,0.15);
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.escape-item {
  display: flex;
  justify-content: space-between;
  padding: 8rpx 0;
  font-size: 28rpx;
}

.escape-label {
  opacity: 0.85;
}

.escape-value {
  font-weight: bold;
}

.escape-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.escape-btn-danger {
  flex: 1;
  background: #ffffff;
  color: #cc0000;
  font-weight: bold;
  border-radius: 12rpx;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
}

.escape-btn-voice {
  flex: 1;
  background: rgba(255,255,255,0.3);
  color: #ffffff;
  border-radius: 12rpx;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
}

.escape-btn-test {
  width: 100%;
  background: #31869B;
  color: #ffffff;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: bold;
  height: 100rpx;
  line-height: 100rpx;
  padding: 0;
}

.escape-btn-stop {
  flex: 1 1 100%;
  background: rgba(0, 0, 0, 0.25);
  color: #ffffff;
  font-weight: bold;
  border-radius: 12rpx;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
  margin-bottom: 10rpx;
}

@keyframes escape-bounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-10rpx); }
}